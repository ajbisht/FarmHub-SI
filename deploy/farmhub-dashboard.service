[Unit]
Description=FarmHub Irrigation FastAPI PWA Web Dashboard
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/RasberryPI
EnvironmentFile=/home/pi/RasberryPI/.env
ExecStart=/home/pi/RasberryPI/.venv/bin/python -m uvicorn dashboard.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=farmhub-dashboard

# Sandboxing & Resource constraints for Pi Zero 2 (512MB RAM)
MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
