# ==============================================================================
# Autonomous Farm Irrigation POC — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to Git!
# ==============================================================================

# MQTT Broker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE_SEC=60

# Location Settings (for Weather API)
# Defaults to Ghaziabad / Delhi NCR
LATITUDE=28.67
LONGITUDE=77.45
LOCATION_NAME=Ghaziabad, IN

# Weather API (OpenWeatherMap Free Tier)
# Get a free key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=

# LLM Provider Selection: "groq" | "openai" | "anthropic" | "gemini" | "ollama" | "local"
# Default: groq (fast & free tier)
LLM_PROVIDER=groq

# 1. Groq (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 4. Google Gemini (Free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 5. Local Ollama (Completely offline on your PC/server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Irrigation Timing & Intervals (in minutes)
SENSE_INTERVAL_MIN=10
VERIFY_DELAY_MIN=15

# Safety Guardrails
MAX_PUMP_SECONDS=45
MIN_HOURS_BETWEEN_WATERINGS=2.0
MAX_WATERINGS_PER_DAY=4
MAX_SAFE_MOISTURE_PCT=70.0

# Operational Mode
# When DRY_RUN=true, decisions are logged but physical pump commands are not sent
DRY_RUN=true

# Database Path
SQLITE_DB_PATH=farm_irrigation.db
